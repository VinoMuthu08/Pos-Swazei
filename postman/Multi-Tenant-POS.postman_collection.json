          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "method": "PATCH",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Product\",\n  \"price\": 21.99\n}"
        },
        "url": "{{baseUrl}}/products/{{productId}}"
