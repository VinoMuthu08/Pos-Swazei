{
  "info": {
    "_postman_id": "76a78d60-b752-4e16-a4df-70e640511a12",
    "name": "Multi-Tenant POS",
    "description": "Sample manager, owner, and platform-admin requests. Set samplePassword to the seed password and run the matching login request before protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "sampleEmail", "value": "manager-a@example.com" },
    { "key": "otherSampleEmail", "value": "manager-b@example.com" },
    { "key": "ownerEmail", "value": "owner-a@example.com" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "samplePassword", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "ownerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "merchantId", "value": "" },
    { "key": "createdMerchantId", "value": "" },
    { "key": "createdOwnerId", "value": "" },
    { "key": "storeId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "saleId", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{sampleEmail}}\",\n  \"password\": \"{{samplePassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeded', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "if (body.data && body.data.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.length) pm.collectionVariables.set('productId', body.data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Restock sample product",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 5\n}"
        },
        "url": "{{baseUrl}}/inventory/{{productId}}/restock"
      }
    },
    {
      "name": "Create sale",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ],\n  \"paymentMethod\": \"CASH\"\n}"
        },
        "url": "{{baseUrl}}/sales"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.id) pm.collectionVariables.set('saleId', body.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List store sales",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/sales"
      }
    },
    {
      "name": "Health check",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Login as owner",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{samplePassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeded', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "if (body.data && body.data.accessToken) pm.collectionVariables.set('ownerToken', body.data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login as platform admin",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{samplePassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeded', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "if (body.data && body.data.accessToken) pm.collectionVariables.set('adminToken', body.data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create merchant",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Merchant\"\n}" },
        "url": "{{baseUrl}}/merchants"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.id) pm.collectionVariables.set('createdMerchantId', body.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create merchant owner",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Merchant Owner\",\n  \"email\": \"new-owner-{{$guid}}@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"role\": \"MERCHANT_OWNER\",\n  \"merchantId\": \"{{createdMerchantId}}\"\n}"
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.id) pm.collectionVariables.set('createdOwnerId', body.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List merchants",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/merchants"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.length) pm.collectionVariables.set('merchantId', body.data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get merchant",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/merchants/{{merchantId}}"
      }
    },
    {
      "name": "Update merchant",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Merchant Name\"\n}" },
        "url": "{{baseUrl}}/merchants/{{merchantId}}"
      }
    },
    {
      "name": "Create store",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Store\",\n  \"address\": \"Main Street\"\n}"
        },
        "url": "{{baseUrl}}/stores"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.id) pm.collectionVariables.set('storeId', body.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List stores",
      "request": { "method": "GET", "url": "{{baseUrl}}/stores" }
    },
    {
      "name": "Get store",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/stores/{{storeId}}"
      }
    },
    {
      "name": "Update store",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "method": "PATCH",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Store Name\",\n  \"address\": \"Updated address\"\n}"
        },
        "url": "{{baseUrl}}/stores/{{storeId}}"
      }
    },
    {
      "name": "Create user",
      "request": {
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Store User\",\n  \"email\": \"new-user-{{$guid}}@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"role\": \"CASHIER\"\n}"
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.id) pm.collectionVariables.set('userId', body.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List users",
      "request": { "method": "GET", "url": "{{baseUrl}}/users" }
    },
    {
      "name": "Get my profile",
      "request": { "method": "GET", "url": "{{baseUrl}}/users/me" }
    },
    {
      "name": "Get user",
      "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" }
    },
    {
      "name": "Create product",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"NEW-{{$guid}}\",\n  \"name\": \"New Product\",\n  \"description\": \"Sample product\",\n  \"price\": 19.99\n}"
        },
        "url": "{{baseUrl}}/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.id) pm.collectionVariables.set('productId', body.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get product",
      "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" }
    },
